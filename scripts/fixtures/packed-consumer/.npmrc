# Nub supply-chain age gate: the consumer resolves the exact Foldkit 0.147 /
# Effect rc.109 pins from the registry (no lockfile), which were published
# less than 24h ago. Exempt the exact pins; file: tarballs are already exempt.
minimum-release-age-exclude=["foldkit@0.147.0","@foldkit/ui@0.147.0","@foldkit/vite-plugin@0.14.0","effect@4.0.0-rc.109","@effect/vitest@4.0.0-rc.109"]
# Match the repo linker pins so the throwaway install lays out node_modules
# the same way as the workspace (local .store, not the global virtual store).
node-linker=isolated
enableGlobalVirtualStore=false
