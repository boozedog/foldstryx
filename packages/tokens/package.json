{
  "name": "@foldstryx/tokens",
  "version": "0.1.0",
  "description": "Astryx-faithful design tokens for StyleX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/boozedog/foldstryx.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./index.stylex.ts": "./src/index.stylex.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./index.stylex.ts": {
        "types": "./dist/index.stylex.d.ts",
        "import": "./dist/index.stylex.js"
      },
      "./index.stylex.js": {
        "types": "./dist/index.stylex.d.ts",
        "import": "./dist/index.stylex.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@stylexjs/stylex": "^0.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node ../../scripts/prepack-stage-publish-manifest.mjs",
    "postpack": "node ../../scripts/postpack-restore-workspace-manifest.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/check-token-fidelity.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
