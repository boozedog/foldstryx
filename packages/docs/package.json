{
  "name": "@foldstryx/docs",
  "version": "0.1.0",
  "description": "Platform-neutral Foldstryx documentation composition (shell, typed routes, navigation)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/boozedog/foldstryx.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@foldstryx/foldkit": "workspace:*",
    "@foldstryx/kitchen-sink": "workspace:*",
    "@foldstryx/styles": "workspace:*"
  },
  "peerDependencies": {
    "@foldkit/ui": ">=0.113.0",
    "effect": ">=4.0.0-beta.83",
    "foldkit": ">=0.113.0"
  },
  "devDependencies": {
    "@effect/platform-browser": "4.0.0-beta.83",
    "@effect/vitest": "4.0.0-beta.83",
    "@foldkit/ui": "^0.113.0",
    "effect": "4.0.0-beta.83",
    "foldkit": "^0.113.0",
    "happy-dom": "^20.10.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
