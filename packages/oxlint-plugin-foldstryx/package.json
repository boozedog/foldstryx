{
  "name": "@foldstryx/oxlint-plugin",
  "version": "0.0.1",
  "private": true,
  "description": "Oxlint rules for Foldstryx: Effect-async ban plus StyleX token / null-override / Foldkit clobber rules",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "nub run clean && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "effect-oxlint": "^0.3.3"
  },
  "devDependencies": {
    "effect": "4.0.0-beta.100",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
