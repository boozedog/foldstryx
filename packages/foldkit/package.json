{
  "name": "@foldstryx/foldkit",
  "version": "0.3.0",
  "description": "Astryx-styled Foldkit view helpers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/boozedog/foldstryx.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.109",
    "@foldkit/ui": "0.147.0",
    "effect": "4.0.0-rc.109",
    "foldkit": "0.147.0",
    "happy-dom": "^20.10.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.19.0",
    "@foldstryx/styles": "workspace:*"
  },
  "peerDependencies": {
    "@foldkit/ui": ">=0.147.0",
    "effect": ">=4.0.0-rc.109",
    "foldkit": ">=0.147.0"
  }
}
