{
  "name": "@foldstryx/styles",
  "version": "0.2.1",
  "description": "Astryx-inspired component styles for StyleX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/boozedog/foldstryx.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./document.global.css": "./src/document.global.css"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./document.global.css": "./src/document.global.css"
    }
  },
  "files": [
    "dist",
    "src/document.global.css",
    "src/fonts",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@foldstryx/tokens": "workspace:*",
    "@stylexjs/stylex": "^0.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node ../../scripts/prepack-stage-publish-manifest.mjs",
    "postpack": "node ../../scripts/postpack-restore-workspace-manifest.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
