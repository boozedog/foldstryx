# Nub: keep the isolated (pnpm-style) virtual store inside node_modules.
# Global-virtual-store breaks effect-lens 0.1.0 oxlint find-up; force it off.
node-linker=isolated
enableGlobalVirtualStore=false
# Nub supply-chain age gate: exempt the exact Foldkit 0.147 / Effect rc.109
# pins this repo targets (published < 24h ago). Frozen installs are unaffected.
minimum-release-age-exclude=["foldkit@0.147.0","@foldkit/ui@0.147.0","@foldkit/vite-plugin@0.14.0","@foldkit/devtools@0.147.0","@foldkit/devtools-mcp@0.16.0","effect@4.0.0-rc.109","@effect/vitest@4.0.0-rc.109"]
