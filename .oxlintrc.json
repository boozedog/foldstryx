{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@foldkit/oxlint-plugin/recommended.json"],
  "plugins": ["typescript"],
  "jsPlugins": [
    {
      "name": "foldstryx",
      "specifier": "@foldstryx/oxlint-plugin"
    },
    {
      "name": "stylex",
      "specifier": "@stylexjs/eslint-plugin"
    },
    {
      "name": "lens",
      "specifier": "effect-lens/dist/plugin/index.js"
    }
  ],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ],
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_"
      }
    ],
    "lens/no-async-function": "error",
    "lens/no-await-expression": "error",
    "lens/no-new-promise": "error",
    "foldstryx/no-hardcoded-styles": "error",
    "foldstryx/no-stylex-null-override": "error",
    "foldstryx/no-stylex-clobber": "error",
    "stylex/valid-styles": "error",
    "stylex/valid-shorthands": "error",
    "stylex/no-unused": "error",
    "stylex/no-legacy-contextual-styles": "error",
    "stylex/no-conflicting-props": "error",
    "stylex/no-nonstandard-styles": "error",
    "stylex/no-lookahead-selectors": "error",
    "stylex/sort-keys": "warn",
    "stylex/enforce-extension": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "typescript/consistent-type-assertions": "off",
        "lens/no-async-function": "off",
        "lens/no-await-expression": "off",
        "lens/no-new-promise": "off"
      }
    },
    {
      "files": ["packages/styles/**", "packages/tokens/**"],
      "rules": {
        "stylex/enforce-extension": "off"
      }
    },
    {
      "files": ["packages/foldkit/src/dialog.ts"],
      "rules": {
        "foldkit/no-empty-children-array": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "**/*.d.ts",
    "packages/oxlint-plugin-foldstryx/",
    "scripts/**",
    "**/vite.config.ts",
    "**/vitest.config.ts",
    "**/vite.aliases.ts"
  ]
}
