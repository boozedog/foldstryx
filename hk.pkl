amends "package://github.com/jdx/hk/releases/download/v1.48.0/hk@1.48.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.48.0/hk@1.48.0#/Builtins.pkl"

// Glob-scoped steps run on changed files for pre-commit.
local linters = new Mapping<String, Step> {
  ["format"] {
    glob = List("**/*.{ts,tsx,css,mjs,json}")
    exclude = List("**/node_modules/**", "**/dist/**", "pnpm-lock.yaml")
    check = "pnpm format:check"
  }
  ["lint"] {
    glob = List("**/*.{ts,tsx}")
    exclude = List("**/node_modules/**", "**/dist/**")
    check = "pnpm lint:ci"
  }
  ["typecheck"] {
    glob = List("**/*.{ts,tsx}")
    exclude = List("**/node_modules/**", "**/dist/**")
    check = "pnpm typecheck"
  }
  ["test"] {
    glob = List("**/*.test.ts")
    exclude = List("**/node_modules/**", "**/dist/**")
    check = "pnpm test"
  }
  ["waivers"] {
    glob = List(
      ".oxlintrc.json",
      ".fallowrc.json",
      ".changeset/config.json",
      "**/*.{ts,tsx,js,jsx,mjs,cjs,css}",
      "scripts/check-waiver-allowlist.mjs",
      "packages/oxlint-plugin-foldstryx/src/async-allowlist.ts"
    )
    exclude = List("**/node_modules/**", "**/dist/**")
    check = "pnpm check:waivers"
  }
}

// hk is local git hooks only. `pnpm check` / CI do not evaluate this file.
// Pre-push is the full gate plus `changeset status --since=origin/master`.
local prePushGate = new Mapping<String, Step> {
  ["format:check"] {
    check = "pnpm format:check"
  }
  ["lint"] {
    check = "pnpm lint"
  }
  ["typecheck"] {
    check = "pnpm typecheck"
  }
  ["fallow"] {
    check = "pnpm check:fallow"
  }
  ["test"] {
    check = "pnpm test"
  }
  ["async-allowlist"] {
    check = "pnpm check:async-allowlist"
  }
  ["waivers"] {
    check = "pnpm check:waivers"
  }
  ["tokens"] {
    check = "pnpm check:tokens"
  }
  ["lint-fixtures"] {
    depends = List("lint")
    check = "pnpm check:lint-fixtures"
  }
  ["demo"] {
    check = "pnpm check:demo"
  }
  ["packed"] {
    check = "pnpm check:packed"
  }
  ["changeset-since"] {
    check = "pnpm check:changeset:pre-push"
  }
}

hooks {
  ["pre-commit"] {
    fix = false
    stash = "git"
    steps {
      ...linters
      // === effect-lens:start ===
      ["effect-lens"] {
        check = "'node_modules/.bin/effect-lens' check --mode unified --changed --workspace 'packages/foldkit'"
      }
      // === effect-lens:end ===
    }
  }
  ["pre-push"] {
    steps = prePushGate
  }
}
