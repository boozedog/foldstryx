{
  "$schema": "https://fallow.systems/config-schema.json",
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/*.d.ts",
    "**/.changeset/**",
    "scripts/fixtures/**",
    "scripts/check-lint-fixtures.mjs",
    "scripts/check-waiver-allowlist.mjs",
    "packages/oxlint-plugin-foldstryx/**"
  ],
  "ignoreDependencies": ["@foldkit/oxlint-plugin", "@foldstryx/oxlint-plugin"],
  "duplicates": {
    "skipLocal": true
  },
  "health": {
    "thresholdOverrides": [
      {
        "files": [
          "packages/oxlint-plugin-foldstryx/src/guards.ts",
          "packages/oxlint-plugin-foldstryx/src/stylex-ast.ts",
          "packages/oxlint-plugin-foldstryx/src/rules/no-await-expression.ts",
          "packages/oxlint-plugin-foldstryx/src/rules/no-new-promise.ts",
          "packages/oxlint-plugin-foldstryx/src/rules/no-hardcoded-styles.ts",
          "packages/oxlint-plugin-foldstryx/src/rules/no-stylex-clobber.ts",
          "packages/oxlint-plugin-foldstryx/src/rules/no-stylex-null-override.ts"
        ],
        "maxCrap": 140,
        "maxCognitive": 25,
        "reason": "Dev-tooling oxlint plugin rules: CRAP inflated by being untested. Verify via scripts/check-lint-fixtures.mjs."
      },
      {
        "files": ["scripts/check-demo-smoke.mjs"],
        "maxCrap": 200,
        "maxUnitSize": 140,
        "maxCognitive": 20,
        "reason": "Demo smoke CDP helper is a Node script verified by nub run check:demo, not library code."
      },
      {
        "files": ["scripts/check-packed-consumer.mjs"],
        "maxCrap": 200,
        "maxUnitSize": 140,
        "maxCognitive": 20,
        "reason": "Packed-consumer smoke CDP helper is a Node script verified by nub run check:packed, not library code."
      },
      {
        "files": ["scripts/package-manager-guard.mjs"],
        "maxCrap": 200,
        "maxUnitSize": 140,
        "maxCognitive": 25,
        "reason": "Package-manager guard is a Node script verified by nub run check:pm-guard, not library code."
      },
      {
        "files": [
          "scripts/assert-release-publishes-tarballs.mjs",
          "scripts/changeset-publish.mjs",
          "scripts/check-publish-packument.mjs",
          "scripts/normalize-tarball-manifest.mjs",
          "scripts/nub-pack.mjs",
          "scripts/postpack-restore-workspace-manifest.mjs",
          "scripts/prepack-stage-publish-manifest.mjs",
          "scripts/release-packages.mjs",
          "scripts/resolve-real-npm.mjs",
          "scripts/workspace-publish-manifest.mjs"
        ],
        "maxCrap": 200,
        "maxUnitSize": 140,
        "maxCognitive": 20,
        "reason": "Nub pack/publish adapter scripts verified by nub run check:packed and release tooling, not library code."
      },
      {
        "files": [
          "packages/foldkit/src/checkbox.ts",
          "packages/foldkit/src/switch.ts",
          "packages/foldkit/src/selector.ts"
        ],
        "maxCrap": 100,
        "reason": "Small closed-union form dispatchers mirror the donor API and are covered by sink/browser verification."
      },
      {
        "files": ["packages/kitchen-sink/src/index.ts"],
        "maxCrap": 300,
        "maxUnitSize": 140,
        "maxCognitive": 30,
        "maxCyclomatic": 35,
        "reason": "Kitchen-sink catalog view intentionally composes all primitive demonstrations in one vertical page."
      },
      {
        "files": ["packages/foldkit/src/gridFocus.ts"],
        "maxCognitive": 35,
        "maxCyclomatic": 30,
        "maxCrap": 140,
        "reason": "Grid keyboard navigation step keeps donor geometry together; covered by gridFocus unit and scene tests."
      },
      {
        "files": ["packages/foldkit/src/treeList.ts"],
        "maxCrap": 70,
        "reason": "Recursive tree row renderer and keyboard step keep APG tree semantics together; covered by TreeList tests and scene story."
      },
      {
        "files": ["packages/foldkit/src/progressBar.ts"],
        "maxCognitive": 22,
        "reason": "Progress bar view composes header, ARIA, and variant fill modes; covered by ProgressBar tests."
      },
      {
        "files": ["packages/docs/src/view.ts"],
        "maxCrap": 40,
        "reason": "Docs view dispatches typed routes to focused pages; covered by docs tests and browser verification."
      },
      {
        "files": ["packages/foldkit/src/sidebar.ts"],
        "maxCrap": 220,
        "maxCognitive": 60,
        "maxUnitSize": 180,
        "reason": "Recursive Sidebar rendering keeps Astryx navigation, expansion, and accessibility semantics together; behavior is covered by Sidebar tests and browser verification."
      },
      {
        "files": [
          "packages/foldkit/src/text.ts",
          "packages/foldkit/src/card.ts",
          "packages/foldkit/src/row.ts"
        ],
        "maxCrap": 100,
        "reason": "Small closed-union primitive dispatchers are intentionally explicit."
      },
      {
        "files": ["packages/foldkit/src/text.ts"],
        "maxCrap": 120,
        "reason": "Closed typography dispatch is intentionally explicit."
      }
    ]
  },
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "circular-dependencies": "error",
    "re-export-cycle": "warn",
    "duplicate-exports": "off"
  }
}
