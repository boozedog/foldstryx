{
  "$schema": "https://fallow.systems/config-schema.json",
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/*.d.ts",
    "**/.changeset/**"
  ],
  "ignoreDependencies": ["@foldkit/oxlint-plugin"],
  "duplicates": {
    "skipLocal": true
  },
  "health": {
    "thresholdOverrides": [
      {
        "files": [
          "packages/oxlint-plugin-foldstryx/src/guards.ts",
          "packages/oxlint-plugin-foldstryx/src/rules/no-await-expression.ts",
          "packages/oxlint-plugin-foldstryx/src/rules/no-new-promise.ts"
        ],
        "maxCrap": 80,
        "reason": "Dev-tooling oxlint plugin rules: low complexity, CRAP inflated by being untested (bind-aware scope logic). Verify via oxlint fixtures; tests are tracked debt."
      },
      {
        "files": [
          "packages/foldkit/src/switch.ts",
          "packages/foldkit/src/nativeSelect.ts"
        ],
        "maxCrap": 100,
        "reason": "Small closed-union form dispatchers mirror the donor API and are covered by sink/browser verification."
      },
      {
        "files": ["packages/kitchen-sink/src/index.ts"],
        "maxCrap": 100,
        "reason": "Kitchen-sink catalog view intentionally composes all primitive demonstrations in one vertical page."
      },
      {
        "files": [
          "packages/foldkit/src/text.ts",
          "packages/foldkit/src/card.ts",
          "packages/foldkit/src/row.ts"
        ],
        "maxCrap": 100,
        "reason": "Small closed-union primitive dispatchers are intentionally explicit."
      },
      {
        "files": ["packages/foldkit/src/text.ts"],
        "maxCrap": 120,
        "reason": "Closed typography dispatch is intentionally explicit."
      }
    ]
  },
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "circular-dependencies": "error",
    "re-export-cycle": "warn",
    "duplicate-exports": "off"
  }
}
